# Keep bash scripts with Unix line endings. Git for Windows would otherwise turn them into CRLF and bash fails with $'\r' errors.
*.sh text eol=lf
*.tf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.hcl text eol=lf
*.ps1 text eol=crlf
*.md text
*.zip binary
*.pdf binary
